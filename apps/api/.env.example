# ---- Runtime ----
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins for CORS
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
# Pretty-print logs in development (uses pino-pretty). Set false in production.
LOG_PRETTY=true
API_VERSION=v1

# ---- Database (PostgreSQL) ----
# Matches docker-compose.yml at the repo root.
DATABASE_URL=postgresql://trlife:trlife@localhost:5432/trlife?schema=public

# ---- Auth / JWT ----
# REQUIRED in production. Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# ---- Rate limiting (auth endpoints) ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ---- Object storage (documents; Phase 6) ----
# Provider-agnostic. LOCAL stores under STORAGE_LOCAL_DIR; S3-compatible uses the rest.
# STORAGE_DRIVER=s3 works with any S3-compatible endpoint, including Supabase Storage's
# S3 API (set STORAGE_S3_ENDPOINT to https://<project-ref>.storage.supabase.co,
# STORAGE_S3_REGION=auto, and keep STORAGE_S3_FORCE_PATH_STYLE=true).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.storage
# Required when STORAGE_DRIVER=s3 (boot fails if any is missing):
# STORAGE_S3_BUCKET=
# STORAGE_S3_REGION=
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=
# Optional custom endpoint (real AWS S3 omits it; Supabase/MinIO set it):
# STORAGE_S3_ENDPOINT=
# Path-style addressing; keep true for Supabase/MinIO, false for virtual-host AWS.
STORAGE_S3_FORCE_PATH_STYLE=true
# Signed-URL lifetime (seconds)
STORAGE_SIGNED_URL_TTL=300
# HMAC key for signing local-driver URLs. REQUIRED in production (>= 16 chars).
# Generate with: openssl rand -hex 32
STORAGE_SIGNING_KEY=dev-only-storage-signing-key
# Public base URL used to build signed URLs the browser can reach.
STORAGE_PUBLIC_BASE_URL=http://localhost:4000
# Hard upload cap in bytes (default 10 MiB); also advertised in the upload ticket.
STORAGE_MAX_UPLOAD_BYTES=10485760

# ---- Background job queue (match recomputation; Phase 10) ----
# Only the in-memory driver is implemented. It is non-durable (pending jobs are lost
# on restart) but safe here: recompute is idempotent and re-triggered by cache
# staleness. A durable Postgres/Redis driver should be added for multi-instance
# deployments; requesting one fails loudly rather than pretending to work.
QUEUE_DRIVER=memory
QUEUE_ENABLED=true
QUEUE_CONCURRENCY=2
QUEUE_MAX_ATTEMPTS=3
QUEUE_RETRY_DELAY_MS=2000
# How long a cached job_match stays fresh before the read path enqueues a background
# refresh (stale-while-revalidate). Default 6 hours.
MATCH_CACHE_TTL_MS=21600000
