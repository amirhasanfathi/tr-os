# TR Life OS — web app environment (Vite)
# Copy to `.env` (or `.env.local`) and adjust. Never commit a real `.env`.

# Data source seam:
#   mock = in-memory demo data (default, zero setup)
#   http = call the real API in apps/api
VITE_DATA_SOURCE=mock

# Base URL of the API (used when VITE_DATA_SOURCE=http)
VITE_API_URL=http://localhost:4000
